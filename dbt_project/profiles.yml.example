# Copy to ~/.dbt/profiles.yml, or set DBT_PROFILES_DIR to this directory.
#
# Committed as an example only. The real profiles.yml is gitignored because
# the Databricks target carries a token.
#
# Two targets are defined deliberately:
#
#   duckdb      the default. No account, no cluster, no network. A reviewer
#               can run the project immediately.
#
#   databricks  the production-shaped target, matching the platform named in
#               the role. Models are written in portable SQL so switching
#               target is a configuration change, not a rewrite.
#
# NOTE ON DATABRICKS: Community Edition was retired on 1 January 2026 and
# replaced by Databricks Free Edition, which is serverless-only and subject
# to fair-use quotas. The connection shape below targets a SQL warehouse on
# Free Edition or a full workspace.

transactions_platform:
  target: duckdb

  outputs:

    duckdb:
      type: duckdb
      path: ../warehouse/transactions.duckdb
      threads: 4
      # extensions: []

    databricks:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'main') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA', 'transactions') }}"
      threads: 4
