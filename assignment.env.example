# Copy this file to `assignment.env` (or `.env`) and fill in real values.
# Never commit the filled-in version - both names are listed in .gitignore.
#
#   Windows PowerShell:  Copy-Item assignment.env.example assignment.env
#   macOS / Linux:       cp assignment.env.example .env

# Base URL of the assessment REST API, without a trailing slash.
ASSESSMENT_API_BASE_URL=

# Value sent in the `apikey` header.
ASSESSMENT_API_KEY=

# Value sent as `Authorization: Bearer <token>`.
# May be the same as ASSESSMENT_API_KEY. Left blank, the API key is reused.
ASSESSMENT_AUTH_TOKEN=

# ---- Optional tuning. Defaults shown; all are safe to leave unset. ----

# Records requested per page.
# ASSESSMENT_PAGE_SIZE=100

# Retry policy for 429 / 5xx / timeouts.
# ASSESSMENT_MAX_RETRIES=5
# ASSESSMENT_BACKOFF_BASE_SECONDS=0.5
# ASSESSMENT_REQUEST_TIMEOUT_SECONDS=30

# Hours of overlap re-scanned on each incremental run to catch late arrivals.
# ASSESSMENT_LOOKBACK_HOURS=72

# Watermark used on the very first run, when no state file exists.
# ASSESSMENT_INITIAL_WATERMARK=1970-01-01T00:00:00Z
